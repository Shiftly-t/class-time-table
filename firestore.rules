rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && userDoc().data.role == 'admin'; }
    function validTimes(d) { return d.start is string && d.end is string && d.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && d.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && d.start < d.end; }
    function validDate(d) { return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

match /requests/{id} {
  allow read: if signedIn() &&
    (isAdmin() || resource.data.uid == request.auth.uid);

  function validRequest() {
    return signedIn()
      && request.resource.data.keys().hasOnly(
        ['uid','date','start','end','note'])
      && request.resource.data.keys().hasAll(
        ['uid','date','start','end','note'])
      && request.resource.data.uid == request.auth.uid
      && id == request.auth.uid + '_' +
         request.resource.data.date
      && validDate(request.resource.data)
      && validTimes(request.resource.data)
      && request.resource.data.note is string
      && request.resource.data.note.size() <= 200;
  }

  allow create: if validRequest();

  allow update: if validRequest()
    && resource.data.uid == request.auth.uid
    && resource.data.date == request.resource.data.date;

  allow delete: if signedIn()
    && resource.data.uid == request.auth.uid;
}
  
    match /shifts/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['uid','date','start','end']) && request.resource.data.keys().hasAll(['uid','date','start','end']) && request.resource.data.uid is string && exists(/databases/$(database)/documents/users/$(request.resource.data.uid)) && id == request.resource.data.uid + '_' + request.resource.data.date && validDate(request.resource.data) && validTimes(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
