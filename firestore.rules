rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && userDoc().data.role == 'admin'; }
    function validTimes(d) { return d.start is string && d.end is string && d.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && d.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && d.start < d.end; }
    function validDate(d) { return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /requests/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create, update: if signedIn() && ( !exists(/databases/$(database)/documents/requests/$(id)) || resource.data.uid == request.auth.uid ) && request.resource.data.keys().hasOnly(['uid','date','start','end','note']) && request.resource.data.keys().hasAll(['uid','date','start','end','note']) && request.resource.data.uid == request.auth.uid && id == request.auth.uid + '_' + request.resource.data.date && validDate(request.resource.data) && validTimes(request.resource.data) && request.resource.data.note is string && request.resource.data.note.size() <= 200;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /lessons/{lessonId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['date','start','end','teacherUid','student','subject','room'])
        && request.resource.data.keys().hasAll(['date','start','end','teacherUid','student','subject','room'])
        && validDate(request.resource.data) && validTimes(request.resource.data)
        && request.resource.data.teacherUid is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.teacherUid))
        && request.resource.data.student is string && request.resource.data.student.size() > 0 && request.resource.data.student.size() <= 80
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 40
        && request.resource.data.room is string && request.resource.data.room.size() <= 40;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['date','start','end','teacherUid','student','subject','room'])
        && request.resource.data.keys().hasAll(['date','start','end','teacherUid','student','subject','room'])
        && validDate(request.resource.data) && validTimes(request.resource.data)
        && request.resource.data.teacherUid is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.teacherUid))
        && request.resource.data.student is string && request.resource.data.student.size() > 0 && request.resource.data.student.size() <= 80
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 40
        && request.resource.data.room is string && request.resource.data.room.size() <= 40;
      allow delete: if isAdmin();
    }
    function canNote(lessonId) {
      return signedIn() && exists(/databases/$(database)/documents/lessons/$(lessonId))
        && (isAdmin() || get(/databases/$(database)/documents/lessons/$(lessonId)).data.teacherUid == request.auth.uid);
    }
    match /lessonNotes/{lessonId} {
      allow read: if canNote(lessonId);
      allow create, update: if canNote(lessonId)
        && request.resource.data.keys().hasOnly(['text','updatedBy','updatedAt'])
        && request.resource.data.keys().hasAll(['text','updatedBy','updatedAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is string;
      allow delete: if isAdmin();
    }
    match /shifts/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['uid','date','start','end']) && request.resource.data.keys().hasAll(['uid','date','start','end']) && request.resource.data.uid is string && exists(/databases/$(database)/documents/users/$(request.resource.data.uid)) && id == request.resource.data.uid + '_' + request.resource.data.date && validDate(request.resource.data) && validTimes(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
