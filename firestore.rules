rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function studentPath(id) {
      return /databases/$(database)/documents/schoolStudents/$(id);
    }
    // Only staff with a centrally assigned role may access school data.
    // Staff cannot create or change their own role from the web application.
    function isMember() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role in ['admin', 'employee'];
    }
    function isAdmin() {
      return isMember()
        && get(userPath(request.auth.uid)).data.role == 'admin';
    }
    function validEntry(d) {
      return d.keys().hasOnly(['studentId','studentName','grade','school','teacherUid','teacherName','date','start','end','subject','status','memo','memoUpdatedAt','nextDates','regularId','courseId'])
        && d.keys().hasAll(['studentId','studentName','grade','school','teacherUid','teacherName','date','start','end','subject','status','memo','nextDates'])
        && d.studentId is string && exists(studentPath(d.studentId))
        && d.studentName is string && d.studentName.size() <= 80
        && d.grade is string && d.grade.size() <= 30
        && d.school is string && d.school.size() <= 80
        && d.teacherUid is string && exists(userPath(d.teacherUid))
        && d.teacherName is string && d.teacherName.size() <= 100
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.start is string && d.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.end is string && d.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.start < d.end
        && d.subject is string && d.subject.size() > 0 && d.subject.size() <= 80
        && d.status in ['scheduled','done','cancelled']
        && d.memo is string && d.memo.size() <= 2000
        && (!('memoUpdatedAt' in d) || d.memoUpdatedAt == null || d.memoUpdatedAt is timestamp)
        && d.nextDates is list && d.nextDates.size() <= 2
        && (!('regularId' in d) || (d.regularId is string && d.regularId.size() <= 50))
        // A course entry belongs to one registered course and may only be
        // saved on a date within that course. The UI additionally checks slots.
        && (!('courseId' in d) || (
          d.courseId is string && d.courseId.size() > 0 && d.courseId.size() <= 100
          && !('regularId' in d)
          && exists(/databases/$(database)/documents/specialCourses/$(d.courseId))
          && d.date >= get(/databases/$(database)/documents/specialCourses/$(d.courseId)).data.startDate
          && d.date <= get(/databases/$(database)/documents/specialCourses/$(d.courseId)).data.endDate
        ));
    }

    match /users/{uid} {
      allow read: if isMember();
      // Manage staff profiles through Firebase Console / trusted admin backend only.
      allow create, update, delete: if false;
    }
    match /schoolStudents/{id} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();
    }
    match /monthlyTargets/{id} {
      allow read, create, update, delete: if isAdmin();
    }
    match /timetableEntries/{id} {
      allow read: if isMember();
      // Employees: NO creates, updates, or deletes (including memo/status).
      allow create, update: if isAdmin() && validEntry(request.resource.data);
      allow delete: if isAdmin();
    }
    match /notifications/{uid}/items/{id} {
      allow read: if isMember() && uid == request.auth.uid;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['message','date','read','createdAt'])
        && request.resource.data.keys().hasOnly(['message','date','read','createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 200
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      // The teacher cannot even mark a notification as read in Firestore.
      allow update, delete: if isAdmin();
    }
    // Seasonal course definitions. Staff can view, only admins can modify.
    match /specialCourses/{id} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name','type','startDate','endDate','periods','updatedBy','updatedAt'])
        && request.resource.data.keys().hasAll(['name','type','startDate','endDate','periods','updatedBy','updatedAt'])
        && request.resource.data.type in ['spring','summer','winter']
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.startDate is string
        && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.endDate is string
        && request.resource.data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.startDate <= request.resource.data.endDate
        && request.resource.data.periods is list
        && request.resource.data.periods.size() >= 1
        && request.resource.data.periods.size() <= 12
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
    // Whole-school holidays: readable by staff; editable only by school admins.
    match /schoolClosures/{dateId} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        && dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['date','note','updatedBy','updatedAt'])
        && request.resource.data.keys().hasAll(['date','note','updatedBy','updatedAt'])
        && request.resource.data.date == dateId
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
    // No match for other collections: access is denied by default.
  }
}
