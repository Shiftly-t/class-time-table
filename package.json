{
  "name": "shiftly-t-quality-checks",
  "private": true,
  "scripts": {
    "test": "npm run test:rules:static && npm run test:seasonal && npm run test:stage3 && node --test tests/booking-transport.cjs && npm run test:normal:server && npm run test:normal:client && npm run test:normal:extended && node tests/config-guard.cjs && node tests/teacher-weekly-work.cjs && node tests/pr1-review.cjs && node tests/audit.cjs",
    "test:rules:static": "node tests/rules-compatibility.cjs",
    "test:rules": "npm --prefix tests/rules test",
    "test:work:rules": "npm --prefix tests/rules run test:work",
    "test:normal:server": "node --test tests/server/normal-authority.test.cjs",
    "test:normal:rules": "npm --prefix tests/rules run test:normal-authority",
    "test:normal:client": "node --test tests/server/normal-client.test.cjs",
    "test:normal:extended": "node --test tests/server/extended-operations.test.cjs tests/server/extended-client.test.cjs",
    "test:stage3": "node --test tests/stage3/*.test.cjs",
    "test:stage3:inventory": "node tools/check-write-inventory.cjs",
    "test:seasonal": "node --test tests/server/seasonal-policy.test.cjs tests/server/seasonal-client.test.cjs",
    "test:seasonal:rules": "npm --prefix tests/rules run test:seasonal"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
